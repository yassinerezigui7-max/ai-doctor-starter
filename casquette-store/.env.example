# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Nothing here is required to run the site:
# with NEXT_PUBLIC_ORDER_ENDPOINT empty the order form runs in MOCK MODE
# (900ms simulated request, always succeeds, payload logged to the console).
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser POSTs the order. Use the bundled proxy route:
#   NEXT_PUBLIC_ORDER_ENDPOINT=/api/order
# Leave empty for mock mode.
NEXT_PUBLIC_ORDER_ENDPOINT=

# ── Server-only (never exposed to the browser) ───────────────────────────────
# The Google Apps Script Web App /exec URL. See GOOGLE_SHEETS.md.
# When empty, /api/order accepts the order and logs it instead of forwarding.
ORDER_ENDPOINT=

# Shared secret, must match TOKEN in apps-script/Code.gs.
ORDER_TOKEN=
